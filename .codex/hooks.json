{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel) && python3 \"$root\"/workflow/agent-scope/guard.py guard",
            "statusMessage": "Checking the agent's write scope",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel) && python3 \"$root\"/workflow/evals/eval.py usage --quiet --lifecycle-hook",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ]
  }
}
